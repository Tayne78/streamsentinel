# Copy to .env and adjust. Every value has a sensible default.

# binance = live market data, simulator = synthetic stream with labelled anomalies
SOURCE=binance
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
WINDOW_SECONDS=10
WATERMARK_SECONDS=3

# Override the z-score threshold chosen during training (e.g. 8 for fewer alerts on live data)
Z_THRESHOLD=

# Use Binance's market-data-only endpoint if stream.binance.com is blocked in your region
BINANCE_WS_URL=wss://stream.binance.com:9443/stream

SIM_ANOMALY_RATE=0.03

# Host ports (MLflow defaults to 5001 because macOS AirPlay occupies 5000)
API_PORT=8000
MLFLOW_PORT=5001
